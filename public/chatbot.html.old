<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Model Playground</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            height: 100vh;
            overflow: hidden;
            background: #0f0f0f;
            color: #e0e0e0;
        }

        .container {
            display: flex;
            height: 100vh;
        }

        .panel {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-right: 1px solid #2a2a2a;
        }

        .left-panel {
            width: 320px;
            background: #1a1a1a;
        }

        .middle-panel {
            flex: 1;
            background: #161616;
        }

        .right-panel {
            width: 300px;
            background: #1a1a1a;
        }

        .panel-header {
            padding: 16px;
            background: #222;
            border-bottom: 1px solid #2a2a2a;
            font-weight: 600;
            font-size: 14px;
        }

        .panel-content {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
        }

        .input-group {
            margin-bottom: 12px;
        }

        .input-group label {
            display: block;
            margin-bottom: 4px;
            font-size: 12px;
            color: #999;
        }

        input, textarea, select {
            width: 100%;
            padding: 8px;
            background: #2a2a2a;
            border: 1px solid #3a3a3a;
            border-radius: 4px;
            color: #e0e0e0;
            font-size: 13px;
            font-family: inherit;
        }

        /* Password container styles */
        .password-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-container input {
            padding-right: 35px; /* Make room for the eye icon */
        }

        .toggle-password {
            position: absolute;
            right: 5px;
            background: none;
            border: none;
            color: #888;
            cursor: pointer;
            padding: 4px;
            font-size: 14px;
            width: auto;
        }

        .toggle-password:hover {
            color: #e0e0e0;
            background: none;
        }

        textarea {
            resize: vertical;
            min-height: 60px;
            font-family: 'Monaco', 'Menlo', monospace;
        }

        button {
            padding: 8px 16px;
            background: #0066cc;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
        }

        button:hover {
            background: #0052a3;
        }

        button.secondary {
            background: #2a2a2a;
        }

        button.secondary:hover {
            background: #3a3a3a;
        }

        button.danger {
            background: #cc3333;
        }

        button.danger:hover {
            background: #aa2222;
        }

        .model-list {
            margin-top: 12px;
        }

        .model-item {
            padding: 10px;
            background: #2a2a2a;
            border-radius: 4px;
            margin-bottom: 8px;
            cursor: pointer;
            border: 2px solid transparent;
        }

        .model-item.active {
            border-color: #0066cc;
            background: #1a3a5a;
        }

        .model-item:hover {
            background: #333;
        }

        .model-name {
            font-weight: 500;
            margin-bottom: 4px;
        }

        .model-url {
            font-size: 11px;
            color: #888;
            word-break: break-all;
        }

        .tabs {
            display: flex;
            background: #1a1a1a;
            border-bottom: 1px solid #2a2a2a;
            overflow-x: auto;
            gap: 4px;
            padding: 8px 8px 0 8px;
        }

        .tab {
            padding: 8px 16px;
            background: #2a2a2a;
            border: none;
            border-radius: 4px 4px 0 0;
            cursor: pointer;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 120px;
        }

        .tab.active {
            background: #161616;
        }

        .tab-close {
            margin-left: auto;
            padding: 0 4px;
            font-weight: bold;
        }

        .tab-close:hover {
            color: #ff4444;
        }

        .chat-container {
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .messages {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
        }

        .message {
            margin-bottom: 16px;
            display: flex;
            gap: 8px;
        }

        .message-role {
            padding: 4px 8px;
            background: #2a2a2a;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            height: fit-content;
            min-width: 70px;
            text-align: center;
        }

        .message-role.user {
            background: #1a4a1a;
        }

        .message-role.assistant {
            background: #1a1a4a;
        }

        .message-role.system {
            background: #4a1a1a;
        }

        .message-role.tool {
            background: #4a3a1a;
        }

        .message-content {
            flex: 1;
            position: relative;
        }

        .message-text {
            padding: 10px;
            background: #2a2a2a;
            border-radius: 4px;
            white-space: pre-wrap;
            word-wrap: break-word;
            min-height: 30px;
            outline: none;
            border: 1px solid transparent;
        }

        .message-text:focus {
            border-color: #0066cc;
        }

        .message-actions {
            display: flex;
            gap: 4px;
            margin-top: 4px;
        }

        .message-actions button {
            padding: 4px 8px;
            font-size: 11px;
        }

        .input-area {
            padding: 16px;
            background: #1a1a1a;
            border-top: 1px solid #2a2a2a;
        }

        .input-row {
            display: flex;
            gap: 8px;
        }

        .input-row textarea {
            flex: 1;
            min-height: 60px;
        }

        .tool-item {
            padding: 10px;
            background: #2a2a2a;
            border-radius: 4px;
            margin-bottom: 8px;
        }

        .tool-name {
            font-weight: 500;
            margin-bottom: 4px;
            font-size: 13px;
        }

        .tool-desc {
            font-size: 11px;
            color: #888;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .checkbox-group input[type="checkbox"] {
            width: auto;
        }

        .param-row {
            display: grid;
            grid-template-columns: 1fr 80px;
            gap: 8px;
            margin-bottom: 8px;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #1a1a1a;
        }

        ::-webkit-scrollbar-thumb {
            background: #3a3a3a;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #4a4a4a;
        }

        .btn-group {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        .status {
            padding: 8px;
            background: #2a2a2a;
            border-radius: 4px;
            font-size: 11px;
            margin-bottom: 12px;
            text-align: center;
        }

        .status.loading {
            background: #3a3a1a;
        }

        .status.error {
            background: #4a1a1a;
        }

        .section {
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid #2a2a2a;
        }

        .section:last-child {
            border-bottom: none;
        }

        .section-title {
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 12px;
            color: #999;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Left Panel: Model Configuration -->
        <div class="panel left-panel">
            <div class="panel-header">Model Configuration</div>
            <div class="panel-content">
                <div class="input-group">
                    <label>API Key</label>
                    <div class="password-container">
                        <input type="password" id="apiKey" placeholder="sk-..." autocomplete="off">
                        <button class="toggle-password" onclick="toggleApiKeyVisibility()" title="Show/Hide API Key">👁️</button>
                    </div>
                </div>

                <div class="input-group">
                    <label>Model Name</label>
                    <input type="text" id="modelName" placeholder="gpt-4o">
                </div>

                <div class="input-group">
                    <label>Base URL</label>
                    <input type="text" id="baseUrl" placeholder="https://api.openai.com/v1">
                </div>

                <div class="param-row">
                    <div class="input-group">
                        <label>Temperature</label>
                        <input type="number" id="temperature" value="0.7" step="0.1" min="0" max="2">
                    </div>
                    <div class="input-group">
                        <label>Max Tokens</label>
                        <input type="number" id="maxTokens" value="2048" step="100">
                    </div>
                </div>

                <div class="param-row">
                    <div class="input-group">
                        <label>Top P</label>
                        <input type="number" id="topP" value="1" step="0.1" min="0" max="1">
                    </div>
                    <div class="input-group">
                        <label>Top K</label>
                        <input type="number" id="topK" value="0" step="1" min="0">
                    </div>
                </div>

                <div class="input-group">
                    <label>System Prompt</label>
                    <textarea id="systemPrompt" placeholder="You are a helpful assistant..."></textarea>
                </div>

                <div class="btn-group">
                    <button onclick="saveModel()">Add Model</button>
                    <button class="secondary" onclick="updateModel()">Update</button>
                </div>

                <div class="model-list" id="modelList"></div>
            </div>
        </div>

        <!-- Middle Panel: Chat -->
        <div class="panel middle-panel">
            <div class="tabs" id="tabs"></div>
            <div class="chat-container">
                <div class="messages" id="messages"></div>
                <div class="input-area">
                    <div id="status" class="status" style="display: none;"></div>
                    <div class="input-row">
                        <textarea id="userInput" placeholder="Type your message..."></textarea>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <button onclick="sendMessage()">Send</button>
                            <button class="secondary" onclick="clearChat()">Clear</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Tools -->
        <div class="panel right-panel">
            <div class="panel-header">Options</div>
            <div class="panel-content">
                <div class="section">
                    <div class="section-title">TOOLS</div>
                    <div class="checkbox-group">
                        <input type="checkbox" id="enableTools">
                        <label for="enableTools">Enable Tool Calls</label>
                    </div>

                    <div id="toolsSection">
                        <div id="toolsList"></div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">CHAT MANAGEMENT</div>
                    <div class="btn-group" style="flex-direction: column;">
                        <button onclick="exportChat()">Export Chat</button>
                        <button class="secondary" onclick="document.getElementById('importFile').click()">Import Chat</button>
                        <button class="secondary" onclick="copyCurlRequest()">Copy cURL Request</button>
                    </div>
                    <input type="file" id="importFile" accept=".json" style="display: none;" onchange="importChat(event)">
                </div>
            </div>
        </div>
    </div>

    <script>
        // Predefined tools
        const PREDEFINED_TOOLS = [
            {
                type: "function",
                function: {
                    name: "get_weather",
                    description: "Get the current weather for a location",
                    parameters: {
                        type: "object",
                        properties: {
                            location: {
                                type: "string",
                                description: "City name"
                            },
                            unit: {
                                type: "string",
                                enum: ["celsius", "fahrenheit"],
                                description: "Temperature unit"
                            }
                        },
                        required: ["location"]
                    }
                }
            },
            {
                type: "function",
                function: {
                    name: "calculate",
                    description: "Perform a mathematical calculation",
                    parameters: {
                        type: "object",
                        properties: {
                            expression: {
                                type: "string",
                                description: "Math expression to evaluate"
                            }
                        },
                        required: ["expression"]
                    }
                }
            },
            {
                type: "function",
                function: {
                    name: "search_web",
                    description: "Search the web for information",
                    parameters: {
                        type: "object",
                        properties: {
                            query: {
                                type: "string",
                                description: "Search query"
                            }
                        },
                        required: ["query"]
                    }
                }
            }
        ];

        // State
        let models = [];
        let activeModelIndex = null;
        let chatTabs = [];
        let activeTabIndex = 0;

        // Initialize
        function init() {
            loadFromStorage();
            renderModels();
            renderTabs();
            renderMessages();
            renderTools();
            
            // Auto-save system prompt on change
            document.getElementById('systemPrompt').addEventListener('input', () => {
                if (activeModelIndex !== null) {
                    models[activeModelIndex].systemPrompt = document.getElementById('systemPrompt').value;
                    saveToStorage();
                }
            });

            // Enter to send
            document.getElementById('userInput').addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            // Create first tab if none exist
            if (chatTabs.length === 0) {
                createNewTab();
            }
        }

        // Toggle API Key Visibility
        function toggleApiKeyVisibility() {
            const input = document.getElementById('apiKey');
            const btn = document.querySelector('.toggle-password');
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁️';
            }
        }

        function loadFromStorage() {
            const stored = localStorage.getItem('chatPlayground');
            if (stored) {
                try {
                    const data = JSON.parse(stored);
                    models = data.models || [];
                    activeModelIndex = data.activeModelIndex;
                    chatTabs = data.chatTabs || [];
                    activeTabIndex = data.activeTabIndex || 0;
                    
                    // Validate indices
                    if (activeModelIndex !== null && (activeModelIndex < 0 || activeModelIndex >= models.length)) {
                        activeModelIndex = null;
                    }
                } catch (e) {
                    console.error("Failed to parse local storage", e);
                }
            }

            // Load active model to UI
            if (activeModelIndex !== null && models[activeModelIndex]) {
                loadModelToUI(models[activeModelIndex]);
            }
        }

        function saveToStorage() {
            localStorage.setItem('chatPlayground', JSON.stringify({
                models,
                activeModelIndex,
                chatTabs,
                activeTabIndex
            }));
        }

        function saveModel() {
            const model = getModelFromUI();
            
            // Validation
            if (!model.name) {
                showStatus('Model name is required', 'error');
                return;
            }

            models.push(model);
            activeModelIndex = models.length - 1;
            saveToStorage();
            renderModels();
            showStatus('Model added successfully', '');
            setTimeout(hideStatus, 2000);
        }

        function updateModel() {
            if (activeModelIndex === null) {
                showStatus('No model selected to update', 'error');
                return;
            }
            
            const updatedModel = getModelFromUI();
            models[activeModelIndex] = updatedModel;
            saveToStorage();
            renderModels();
            renderTabs();
            showStatus('Model updated successfully', '');
            setTimeout(hideStatus, 2000);
        }

        function deleteModel(index) {
            models.splice(index, 1);
            if (activeModelIndex === index) {
                activeModelIndex = models.length > 0 ? 0 : null;
            } else if (activeModelIndex > index) {
                activeModelIndex--;
            }
            
            // Update tabs that reference this model
            chatTabs.forEach(tab => {
                if (tab.modelIndex === index) {
                    tab.modelIndex = null;
                } else if (tab.modelIndex > index) {
                    tab.modelIndex--;
                }
            });
            
            saveToStorage();
            renderModels();
            renderTabs();
            
            if (activeModelIndex !== null) {
                loadModelToUI(models[activeModelIndex]);
            } else {
                clearInputs();
            }
        }

        function selectModel(index) {
            activeModelIndex = index;
            loadModelToUI(models[index]);
            
            // Update current tab's model
            if (chatTabs[activeTabIndex]) {
                chatTabs[activeTabIndex].modelIndex = index;
            }
            
            saveToStorage();
            renderModels();
            renderTabs();
        }

        function getModelFromUI() {
            const baseUrlInput = document.getElementById('baseUrl').value.trim();
            // Store exactly what user typed, we will clean it during sendMessage
            
            return {
                apiKey: document.getElementById('apiKey').value,
                name: document.getElementById('modelName').value,
                baseUrl: baseUrlInput,
                temperature: parseFloat(document.getElementById('temperature').value),
                maxTokens: parseInt(document.getElementById('maxTokens').value),
                topP: parseFloat(document.getElementById('topP').value),
                topK: parseInt(document.getElementById('topK').value),
                systemPrompt: document.getElementById('systemPrompt').value
            };
        }

        function loadModelToUI(model) {
            if (!model) return;
            // Explicitly setting value for API Key to fix "not loading" issue
            const apiKeyInput = document.getElementById('apiKey');
            apiKeyInput.value = model.apiKey || '';
            
            document.getElementById('modelName').value = model.name || '';
            document.getElementById('baseUrl').value = model.baseUrl || '';
            document.getElementById('temperature').value = model.temperature || 0.7;
            document.getElementById('maxTokens').value = model.maxTokens || 2048;
            document.getElementById('topP').value = model.topP || 1;
            document.getElementById('topK').value = model.topK || 0;
            document.getElementById('systemPrompt').value = model.systemPrompt || '';
        }

        function clearInputs() {
            document.getElementById('apiKey').value = '';
            document.getElementById('modelName').value = '';
            document.getElementById('baseUrl').value = '';
            document.getElementById('systemPrompt').value = '';
        }

        function renderModels() {
            const list = document.getElementById('modelList');
            list.innerHTML = models.map((model, i) => `
                <div class="model-item ${i === activeModelIndex ? 'active' : ''}" onclick="selectModel(${i})">
                    <div class="model-name">${model.name}</div>
                    <div class="model-url">${model.baseUrl}</div>
                    <div style="margin-top: 8px;">
                        <button class="danger" onclick="event.stopPropagation(); deleteModel(${i})">Delete</button>
                    </div>
                </div>
            `).join('');
        }

        function createNewTab() {
            const tab = {
                id: Date.now(),
                name: `Chat ${chatTabs.length + 1}`,
                messages: [],
                modelIndex: activeModelIndex
            };
            chatTabs.push(tab);
            activeTabIndex = chatTabs.length - 1;
            saveToStorage();
            renderTabs();
            renderMessages();
        }

        function switchTab(index) {
            activeTabIndex = index;
            const tab = chatTabs[index];
            if (tab.modelIndex !== null && models[tab.modelIndex]) {
                activeModelIndex = tab.modelIndex;
                loadModelToUI(models[tab.modelIndex]);
            }
            saveToStorage();
            renderTabs();
            renderMessages();
        }

        function closeTab(index) {
            if (chatTabs.length === 1) return; // Keep at least one tab
            chatTabs.splice(index, 1);
            if (activeTabIndex >= chatTabs.length) {
                activeTabIndex = chatTabs.length - 1;
            }
            saveToStorage();
            renderTabs();
            renderMessages();
        }

        function renderTabs() {
            const container = document.getElementById('tabs');
            container.innerHTML = chatTabs.map((tab, i) => {
                const modelName = tab.modelIndex !== null && models[tab.modelIndex] 
                    ? models[tab.modelIndex].name 
                    : 'No Model';
                return `
                    <button class="tab ${i === activeTabIndex ? 'active' : ''}" onclick="switchTab(${i})">
                        ${modelName}
                        ${chatTabs.length > 1 ? `<span class="tab-close" onclick="event.stopPropagation(); closeTab(${i})">×</span>` : ''}
                    </button>
                `;
            }).join('') + `<button class="tab" onclick="createNewTab()">+</button>`;
        }

        function getCurrentMessages() {
            return chatTabs[activeTabIndex]?.messages || [];
        }

        function renderMessages() {
            const container = document.getElementById('messages');
            const messages = getCurrentMessages();
            container.innerHTML = messages.map((msg, i) => {
                const content = msg.tool_calls 
                    ? `[Tool Calls: ${msg.tool_calls.map(tc => tc.function.name).join(', ')}]${msg.content ? '\n' + msg.content : ''}`
                    : msg.content;
                    
                return `
                    <div class="message">
                        <div class="message-role ${msg.role}">${msg.role}</div>
                        <div class="message-content">
                            <div class="message-text" contenteditable="true" onblur="updateMessage(${i}, this.textContent)">${escapeHtml(content)}</div>
                            <div class="message-actions">
                                <button class="danger" onclick="deleteMessage(${i})">Delete</button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
            container.scrollTop = container.scrollHeight;
        }

        function renderTools() {
            const list = document.getElementById('toolsList');
            list.innerHTML = PREDEFINED_TOOLS.map(tool => `
                <div class="tool-item">
                    <div class="tool-name">${tool.function.name}</div>
                    <div class="tool-desc">${tool.function.description}</div>
                </div>
            `).join('');
        }

        function updateMessage(index, content) {
            const messages = getCurrentMessages();
            messages[index].content = content;
            saveToStorage();
        }

        function deleteMessage(index) {
            const messages = getCurrentMessages();
            messages.splice(index, 1);
            saveToStorage();
            renderMessages();
        }

        function clearChat() {
            if (chatTabs[activeTabIndex]) {
                chatTabs[activeTabIndex].messages = [];
                saveToStorage();
                renderMessages();
            }
        }

        function showStatus(text, type = '') {
            const status = document.getElementById('status');
            status.textContent = text;
            status.className = 'status ' + type;
            status.style.display = 'block';
        }

        function hideStatus() {
            document.getElementById('status').style.display = 'none';
        }

        // Helper to fix double slashes for 405 error
        function normalizeUrl(baseUrl) {
            // Remove trailing slashes
            let cleaned = baseUrl.replace(/\/+$/, "");
            return `${cleaned}/chat/completions`;
        }

        async function sendMessage() {
            const tab = chatTabs[activeTabIndex];
            if (!tab || tab.modelIndex === null) {
                showStatus('Please select a model first', 'error');
                return;
            }

            const input = document.getElementById('userInput');
            const content = input.value.trim();
            if (!content) return;

            const model = models[tab.modelIndex];

            // Add user message
            tab.messages.push({ role: 'user', content });
            input.value = '';
            renderMessages();

            // Prepare messages for API
            const apiMessages = [];
            
            // Add system message if exists
            if (model.systemPrompt) {
                apiMessages.push({ role: 'system', content: model.systemPrompt });
            }

            // Add conversation history
            apiMessages.push(...tab.messages);

            const requestBody = {
                model: model.name,
                messages: apiMessages,
                temperature: model.temperature,
                max_tokens: model.maxTokens,
                top_p: model.topP,
            };

            // Add tools if enabled
            if (document.getElementById('enableTools').checked) {
                requestBody.tools = PREDEFINED_TOOLS;
                requestBody.tool_choice = "auto";
            }

            showStatus('Sending...', 'loading');

            const endpointUrl = normalizeUrl(model.baseUrl);

            try {
                const response = await fetch(endpointUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${model.apiKey}`
                    },
                    body: JSON.stringify(requestBody)
                });

                if (!response.ok) {
                    let errorText = await response.text();
                    // 405 Specific help text
                    if (response.status === 405) {
                        errorText += " (Check your Base URL. Ensure it ends with /v1 if using OpenAI compatible APIs)";
                    }
                    throw new Error(`HTTP ${response.status}: ${errorText}`);
                }

                const data = await response.json();
                const assistantMessage = data.choices[0].message;

                // Handle tool calls
                if (assistantMessage.tool_calls) {
                    tab.messages.push({
                        role: 'assistant',
                        content: assistantMessage.content || '',
                        tool_calls: assistantMessage.tool_calls
                    });

                    // Simulate tool responses
                    for (const toolCall of assistantMessage.tool_calls) {
                        const toolResult = simulateTool(toolCall);
                        tab.messages.push({
                            role: 'tool',
                            content: JSON.stringify(toolResult),
                            tool_call_id: toolCall.id
                        });
                    }
                } else {
                    tab.messages.push({
                        role: 'assistant',
                        content: assistantMessage.content
                    });
                }

                hideStatus();
                saveToStorage();
                renderMessages();
            } catch (error) {
                showStatus(`Error: ${error.message}`, 'error');
                console.error(error);
            }
        }

        function simulateTool(toolCall) {
            const { name, arguments: args } = toolCall.function;
            const params = JSON.parse(args);

            switch (name) {
                case 'get_weather':
                    return {
                        location: params.location,
                        temperature: Math.floor(Math.random() * 30) + 10,
                        unit: params.unit || 'celsius',
                        condition: ['sunny', 'cloudy', 'rainy'][Math.floor(Math.random() * 3)]
                    };
                case 'calculate':
                    try {
                        return { result: eval(params.expression) };
                    } catch (e) {
                        return { error: 'Invalid expression' };
                    }
                case 'search_web':
                    return {
                        query: params.query,
                        results: ['Result 1', 'Result 2', 'Result 3']
                    };
                default:
                    return { error: 'Unknown tool' };
            }
        }

        function exportChat() {
            const tab = chatTabs[activeTabIndex];
            if (!tab) return;

            const exportData = {
                messages: tab.messages,
                model: tab.modelIndex !== null ? models[tab.modelIndex] : null,
                exportDate: new Date().toISOString()
            };

            const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `chat-export-${Date.now()}.json`;
            a.click();
            URL.revokeObjectURL(url);
        }

        function importChat(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data.messages && Array.isArray(data.messages)) {
                        chatTabs[activeTabIndex].messages = data.messages;
                        saveToStorage();
                        renderMessages();
                        showStatus('Chat imported successfully', '');
                        setTimeout(hideStatus, 2000);
                    } else {
                        throw new Error('Invalid chat format');
                    }
                } catch (error) {
                    showStatus('Error importing chat: ' + error.message, 'error');
                }
            };
            reader.readAsText(file);
            event.target.value = ''; // Reset file input
        }

        function copyCurlRequest() {
            const tab = chatTabs[activeTabIndex];
            if (!tab || tab.modelIndex === null) {
                showStatus('Please select a model first', 'error');
                return;
            }

            const model = models[tab.modelIndex];
            const apiMessages = [];
            
            if (model.systemPrompt) {
                apiMessages.push({ role: 'system', content: model.systemPrompt });
            }
            apiMessages.push(...tab.messages);

            const requestBody = {
                model: model.name,
                messages: apiMessages,
                temperature: model.temperature,
                max_tokens: model.maxTokens,
                top_p: model.topP,
            };

            if (document.getElementById('enableTools').checked) {
                requestBody.tools = PREDEFINED_TOOLS;
                requestBody.tool_choice = "auto";
            }

            const endpointUrl = normalizeUrl(model.baseUrl);

            const curl = `curl ${endpointUrl} \\
  -H "Content-Type: application/json" \\
  -H "Authorization: Bearer ${model.apiKey}" \\
  -d '${JSON.stringify(requestBody, null, 2)}'`;

            navigator.clipboard.writeText(curl).then(() => {
                showStatus('cURL request copied to clipboard', '');
                setTimeout(hideStatus, 2000);
            }).catch(err => {
                showStatus('Failed to copy: ' + err.message, 'error');
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Initialize on load
        init();
    </script>
</body>
</html>